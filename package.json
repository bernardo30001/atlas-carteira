{
  "name": "atlas-carteira",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node scripts/test.mjs",
    "test:api": "node scripts/test-api.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy": "vinext build && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate": "wrangler d1 migrations apply atlas-carteira --remote"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "unpdf": "1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.23",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
